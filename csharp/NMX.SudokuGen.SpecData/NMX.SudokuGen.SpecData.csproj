<Project Sdk="Microsoft.NET.Sdk">

  <!-- a dev tool that rewrites spec/tests from the library; it is never packed or shipped -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NMX.SudokuGen.Library\NMX.SudokuGen.Library.csproj" />
  </ItemGroup>

  <!-- the default output folder, the repo's spec/tests, see Core\SpecData.cs -->
  <ItemGroup>
    <AssemblyMetadata Include="SpecTestsDir" Value="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'spec', 'tests'))" />
  </ItemGroup>

</Project>
